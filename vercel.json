{
  "rewrites": [
    { "source": "/audit/:path*", "destination": "/index.html" },
    { "source": "/ncr-view/:path*", "destination": "/index.html" },
    { "source": "/form7", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}